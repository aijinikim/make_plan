{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "agent": "dj-planner",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/greet.mjs",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch",
      "Read(./**)",
      "Edit(./output/**)",
      "Write(./output/**)"
    ]
  }
}
